# Frontend Environment Variables
# Copy to .env for local development or set these in Hostinger build settings.
# Empty = same origin. In development Vite proxies /api to localhost:5000.

VITE_API_URL=

# Public Razorpay key (the payment flow also receives the key from the backend).
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

VITE_APP_NAME=Krushnalaya
VITE_APP_DESCRIPTION=Spiritual Services - Tarot, Reiki & Water Divination
VITE_WHATSAPP_NUMBER=+919893578135

GENERATE_SOURCEMAP=false
