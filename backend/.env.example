# Backend environment variables
# Copy to backend/.env (never commit the real .env file).

NODE_ENV=production
# Hostinger provides PORT; leave this as a local fallback only.
PORT=5000

# MySQL (Hostinger hPanel -> Databases -> MySQL)
# Use localhost when the Node app is hosted on the same Hostinger server.
DB_HOST=localhost
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database

# Single-domain deployment: this is the public site URL.
FRONTEND_URL=https://yourdomain.com
APP_URL=https://yourdomain.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=replace-with-a-64-character-random-secret
JWT_SECRET=replace-with-a-64-character-random-secret

# Razorpay (use live keys for real payments)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional WhatsApp notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Hostinger terminates TLS, so the Node process should stay HTTP.
USE_HTTPS=false
