{
  "name": "spiritual-services-backend",
  "version": "1.0.0",
  "description": "Backend for spiritual services booking with Razorpay payment integration",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/createTables.js",
    "db:seed:services": "node scripts/seedServices.js",
    "db:seed:content": "node scripts/seedContent.js",
    "db:seed:all": "node scripts/seedServices.js && node scripts/seedContent.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.0",
    "razorpay": "^2.9.2",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "tarot",
    "reiki",
    "spiritual",
    "booking",
    "api",
